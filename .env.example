# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# ------------------------------------------------------------------
# Secrets — generate each with:  openssl rand -base64 32
# ------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ------------------------------------------------------------------
# Customer authentication
# ------------------------------------------------------------------
FRONTEND_PUBLIC_URL=http://localhost:3000
STRAPI_PUBLIC_URL=http://localhost:1337
# Should match STRAPI_PUBLIC_URL above (drives Strapi's own server.absoluteUrl)
PUBLIC_URL=http://localhost:1337
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Valhalla <no-reply@example.com>"
EMAIL_REPLY_TO=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# Asaas (payments, sandbox connectivity health-check)
# ------------------------------------------------------------------
ASAAS_API_URL=
ASAAS_API_KEY=
ASAAS_TIMEOUT_MS=
ASAAS_USER_AGENT=
ASAAS_TEST_TOKEN=
ASAAS_WEBHOOK_TOKEN=
# Base URL used only for the Asaas Checkout success/cancel/expired redirects.
# Falls back to FRONTEND_PUBLIC_URL, then localhost:3000. Kept separate from
# FRONTEND_PUBLIC_URL because that one also drives the Google OAuth callback,
# which must stay in sync with the redirect URI registered in Google Cloud.
CHECKOUT_PUBLIC_URL=

# ------------------------------------------------------------------
# Database
#   Local dev and deploy -> postgres
#   The local Docker Compose service overrides DATABASE_HOST to "postgres".
# ------------------------------------------------------------------
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me-local-only
DATABASE_SSL=false

# SQLite remains supported only for recovery/export of legacy local databases.
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# ------------------------------------------------------------------
# Media storage — Cloudflare R2 (S3-compatible)
#   Leave unset to keep uploads on the local disk.
#   Set all three of R2_BUCKET / R2_ENDPOINT / R2_PUBLIC_URL to enable R2.
#   Credentials: R2 -> Manage API Tokens -> Object Read & Write on the bucket.
#   R2_PUBLIC_URL must be the bucket's public/custom domain, NOT the S3
#   endpoint — the S3 endpoint is private and will 401 for site visitors.
# ------------------------------------------------------------------
# R2_BUCKET=valhalla-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://cdn-dev.valhallatecnologia.com.br
# R2_ROOT_PATH=assets/images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------
# Media import script (scripts/import-media.js)
#   Token: admin -> Settings -> API Tokens -> Full access (or custom with
#   upload permissions). Never commit a real token.
# ------------------------------------------------------------------
# STRAPI_URL=http://localhost:1337
# STRAPI_TOKEN=

# Deflow Sandbox — use uma chave dfk_test_* e mantenha os segredos apenas no ambiente
PAYMENT_PROVIDER=deflow
DFLOW_API_URL=https://api.deflow.exchange/v1
DFLOW_KEY_ID=
DFLOW_SECRET=
DFLOW_PASSPHRASE=
DFLOW_WEBHOOK_SECRET=
DFLOW_TEST_PAYER_TAX_NUMBER=
DFLOW_TIMEOUT_MS=10000
