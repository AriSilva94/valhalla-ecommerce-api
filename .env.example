# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# ------------------------------------------------------------------
# Secrets — generate each with:  openssl rand -base64 32
# ------------------------------------------------------------------
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ------------------------------------------------------------------
# Database
#   Local dev  -> sqlite (default, no vars needed)
#   Deploy/VPS -> postgres (set the vars below)
# ------------------------------------------------------------------
DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# --- Postgres (deploy) ---
# DATABASE_CLIENT=postgres
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=change-me
# DATABASE_SSL=false

# ------------------------------------------------------------------
# Media storage — Cloudflare R2 (S3-compatible)
#   Leave unset to keep uploads on the local disk.
#   Set all three of R2_BUCKET / R2_ENDPOINT / R2_PUBLIC_URL to enable R2.
#   Credentials: R2 -> Manage API Tokens -> Object Read & Write on the bucket.
#   R2_PUBLIC_URL must be the bucket's public/custom domain, NOT the S3
#   endpoint — the S3 endpoint is private and will 401 for site visitors.
# ------------------------------------------------------------------
# R2_BUCKET=valhalla-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://cdn-dev.valhallatecnologia.com.br
# R2_ROOT_PATH=assets/images
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------
# Media import script (scripts/import-media.js)
#   Token: admin -> Settings -> API Tokens -> Full access (or custom with
#   upload permissions). Never commit a real token.
# ------------------------------------------------------------------
# STRAPI_URL=http://localhost:1337
# STRAPI_TOKEN=
